{
  "name": "quiz-bot",
  "version": "1.0.0",
  "description": "QuizBot V2.0 - NestJS + Telegraf + PostgreSQL",
  "main": "dist/main.js",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:prod": "npx prisma db push && node dist/main.js",
    "dev": "nodemon",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "setup": "npx prisma generate && npx prisma db push",
    "backup": "bash scripts/backup.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@prisma/client": "^5.22.0",
    "csv-parse": "^6.2.1",
    "multer": "^2.1.1",
    "nestjs-telegraf": "^2.9.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
